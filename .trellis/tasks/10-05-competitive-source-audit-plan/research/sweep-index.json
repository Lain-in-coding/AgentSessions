  "concurrency": "tokio::spawn|thread::spawn|std::thread|rayon|go func|async move|Promise\\.all|worker_threads|new Worker\\(|ThreadPool|spawn_blocking",
  "index_storage": "CREATE VIRTUAL TABLE|fts5|tantivy|duckdb|hnsw|usearch|bm25|embedding|cosine_similar|CREATE INDEX|vectorize|vector_search",
  "resume_launch": "--resume|portable-pty|ConPTY|\\btmux\\b|\\bscreen\\b|--continue|\\bresume\\b|\\battach\\b",
  "secret_redaction": "redact|sanitiz|\\bmask_\\b|api[_-]?key|authorization|bearer|credential|\\btoken\\b",
  "inline_tests": "#\\[cfg\\(test\\)\\]|#\\[tokio::test\\]|#\\[test\\]|func Test|func Benchmark|describe\\(|it\\(|test\\(",
