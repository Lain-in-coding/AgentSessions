  "sql_dynamic": "format!\\([^)\\n]{0,200}(SELECT|INSERT|UPDATE|DELETE)|f\"(SELECT|INSERT|UPDATE|DELETE)|f'(SELECT|INSERT|UPDATE|DELETE)|`(SELECT|INSERT|UPDATE|DELETE)|\"(SELECT|INSERT|UPDATE|DELETE)[^\"]{0,400}\"\\s*(\\+|\\.format|\\$\\{)",
  "provider_paths": "\\.claude[^a-z]|\\.codex[^a-z]|\\.gemini[^a-z]|\\.cursor[^a-z]|\\.opencode[^a-z]|\\.aider[^a-z]|\\.continue[^a-z]|\\.windsurf[^a-z]|\\.zed[^a-z]|\\.goose[^a-z]|\\.pi[^a-z]|\\.kiro[^a-z]|\\.hermes[^a-z]|Antigravity|roo-?code",
